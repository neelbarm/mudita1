# Sarga Studio OS environment.
# EVERY key is optional. The studio runs with zero keys: local JSON store,
# dry-run agents, outbox emails, CSV finance. Each key unlocks one capability;
# run `sarga doctor` to see the live matrix and what each missing key unlocks.

# ---------------------------------------------------------------- studio ----
# Your name, recorded on every human action as human:<name>. Default: neel
STUDIO_OPERATOR=
# Port for the studio HTTP server (n8n calls it). Default: 8787
STUDIO_PORT=
# Bearer token n8n uses to call the server. Unset = open localhost dev mode (warns loudly).
STUDIO_API_TOKEN=
# Public base URL of the studio server, used to build unsubscribe links.
STUDIO_BASE_URL=
# Claude model for live agent runs. Default: claude-sonnet-5
STUDIO_MODEL=

# -------------------------------------------------------------- supabase ----
# System of record. Without these the studio uses a local JSON store (.local/db.json).
# Run sarga-haus/supabase/schema.sql FIRST, then studio/db/migrations/001_studio.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (Settings > Database). Enables `sarga db push` via psql.
SUPABASE_DB_URL=

# -------------------------------------------------------------- anthropic ----
# Unlocks live agent runs. Without it every agent runs in deterministic dry-run
# mode from fixtures/ so the whole machine is testable.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- sourcing ----
# Hyperbrowser: site-signal crawls and directory scrapes for lead sourcing.
HYPERBROWSER_API_KEY=
# Licensed enrichment providers (either or both). Provenance recorded per field.
APOLLO_API_KEY=
HUNTER_API_KEY=

# ------------------------------------------------------------------ email ----
# Resend: outbound sends (after human approval) and the inbound reply webhook.
# Without a key, approved sends land in outbox/ as JSON for manual sending.
RESEND_API_KEY=
# Svix signing secret for Resend webhooks (inbound + delivery events).
RESEND_WEBHOOK_SECRET=
# Verified sender for outreach, e.g. "Neel at Sarga Haus <neel@sargahaus.com>"
OUTREACH_FROM_EMAIL=
# Where internal notifications and self-emails go.
INTAKE_NOTIFY_EMAIL=
# Physical postal address, required by CAN-SPAM. Live sending REFUSES without it.
STUDIO_POSTAL_ADDRESS=
# Secret for HMAC unsubscribe tokens in outreach footers.
UNSUBSCRIBE_SECRET=
# Hard daily cap on outbound sends. Default: 15 (low volume, high specificity).
MAX_DAILY_SENDS=
# Quiet hours (recipient-local assumed = studio local), "HH-HH". Default: 20-07
SEND_QUIET_HOURS=

# ---------------------------------------------------------------- billing ----
# Stripe: invoice mirror + paid/overdue webhooks. Without it, finance runs on
# `sarga finance import <csv>` and manual ledger entries.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- booking ----
# Cal.com webhook secret; bookings create same-day tasks + events.
CALCOM_WEBHOOK_SECRET=

# ----------------------------------------------------------------- notify ----
# Slack incoming webhook for approval-queue pings. Without it, notifications log.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- finance ----
# Runway fallback inputs when Stripe/ledger history is thin (numbers, USD).
STUDIO_MONTHLY_BURN=
STUDIO_CASH_ON_HAND=

# ---------------------------------------------------------------- factory ----
# Where Playwright browsers live. Default: /opt/pw-browsers (this machine).
PLAYWRIGHT_BROWSERS_PATH=

# ------------------------------------------------------------- monitoring ----
SENTRY_DSN=

# -------------------------------------------------------------------- n8n ----
# Used by deploy/docker-compose.yml only.
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_HOST=
