{
  "name": "Sarga 09 · Approval poll",
  "nodes": [
    {
      "id": "node-25",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */2 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "node-26",
      "name": "List pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://studio-server:8787/approvals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Studio API"
        }
      }
    },
    {
      "id": "node-27",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -160
      ],
      "parameters": {
        "content": "Every 2 hours: fetch pending approvals. The server already pings Slack on each new item; this is the belt to that suspender. Wire the output to any channel you like.",
        "width": 460,
        "height": 120
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "List pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
